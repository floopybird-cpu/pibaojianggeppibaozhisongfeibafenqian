      "icon": "icon.svg"
    },
    {
      "location": "artifact",
      "object_type": "LearningDocument",
      "activity": "export",
      "label": "导出 Word",
      "description": "生成可编辑原生公式、表格、图像与旁侧来源。",
      "icon": "icon.svg"
    }
  ],
  "program_language": "format-pipeline/1"
